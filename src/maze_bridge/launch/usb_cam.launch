<launch>
  <arg name="show_image" default="false"/>
  <!-- 不要长期依赖 /dev/videoN 的枚举顺序；实车建议用 udev 创建的
       /dev/robot_camera，并在上层 launch 覆盖 video_device。 -->
  <arg name="video_device" default="/dev/video4"/>
  <arg name="camera_frame_id" default="usb_cam"/>
  <!-- 标定后传入 file:///绝对路径/camera.yaml；空字符串表示未加载标定。 -->
  <arg name="camera_info_url" default=""/>

  <node name="usb_cam" pkg="usb_cam" type="usb_cam_node" output="screen" >
    <param name="video_device" value="$(arg video_device)" />
    <param name="image_width" value="640" />
    <param name="image_height" value="480" />
    <param name="pixel_format" value="mjpeg" />
    <param name="color_format" value="yuv422p" />
    <param name="camera_frame_id" value="$(arg camera_frame_id)" />
    <param name="camera_info_url" value="$(arg camera_info_url)" />
    <param name="io_method" value="mmap"/>
  </node>
  <node if="$(arg show_image)" name="image_view" pkg="image_view" type="image_view" respawn="false" output="screen">
    <remap from="image" to="/usb_cam/image_raw"/>
    <param name="autosize" value="true" />
  </node>
</launch>
