<?xml version="1.0"?>
<launch>
  <arg name="use_stl_footprint" default="true"/>
  <arg name="footprint_file" default="$(find maze_bridge)/config/footprint_stl.yaml"/>
  <!-- Manual calibration: retain lidar safety, without SLAM or navigation. -->
  <arg name="port" default="/dev/ttyUSB0"/>
  <arg name="max_v" default="0.10"/>
  <arg name="max_w" default="0.25"/>
  <arg name="wheel_diameter" default="0.166224818"/>
  <arg name="wheel_base" default="0.408879504"/>
  <arg name="ticks_per_rev" default="4096"/>
  <arg name="left_encoder_sign" default="1"/>
  <arg name="right_encoder_sign" default="1"/>
  <include file="$(find maze_bridge)/launch/slam_toolbox_build_map.launch">
    <arg name="enable_slam" value="false"/>
    <arg name="footprint_file" value="$(arg footprint_file)"/>
    <arg name="use_stl_footprint" value="$(arg use_stl_footprint)"/>
    <arg name="show_rviz" value="false"/>
    <arg name="use_camera" value="false"/>
    <arg name="port" value="$(arg port)"/>
    <arg name="max_v" value="$(arg max_v)"/>
    <arg name="max_w" value="$(arg max_w)"/>
    <arg name="wheel_diameter" value="$(arg wheel_diameter)"/>
    <arg name="wheel_base" value="$(arg wheel_base)"/>
    <arg name="ticks_per_rev" value="$(arg ticks_per_rev)"/>
    <arg name="left_encoder_sign" value="$(arg left_encoder_sign)"/>
    <arg name="right_encoder_sign" value="$(arg right_encoder_sign)"/>
  </include>
</launch>
