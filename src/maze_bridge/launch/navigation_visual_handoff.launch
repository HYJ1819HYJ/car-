<?xml version="1.0"?>
<launch>
  <!-- Navigation searches until the visible blue marker has a clear lidar corridor. -->
  <arg name="map_file"/>
  <!-- Determine the fixed start pose in this map after mapping. -->
  <arg name="initial_pose_x"/>
  <arg name="initial_pose_y"/>
  <arg name="initial_pose_a"/>
  <arg name="course_waypoints_file" default=""/>
  <arg name="auto_start" default="true"/>
  <arg name="show_rviz" default="false"/>
  <arg name="base_port" default="/dev/ttyUSB0"/>
  <arg name="gimbal_port" default="/dev/ttyUSB1"/>
  <arg name="camera_device" default="/dev/video4"/>
  <arg name="camera_info_url" default=""/>
  <arg name="max_speed" default="0.10"/>
  <arg name="max_turn" default="0.25"/>
  <arg name="stop_ratio" default="0.16"/>
  <arg name="facing_tolerance_deg" default="5.0"/>
  <arg name="safety_stop_distance" default="0.12"/>
  <arg name="clear_scans" default="3"/>
  <arg name="max_target_range" default="8.0"/>
  <arg name="range_absolute_tolerance" default="0.25"/>
  <arg name="range_relative_tolerance" default="0.20"/>
  <arg name="corridor_check_standoff" default="0.48"/>
  <arg name="max_sensor_skew" default="0.5"/>

  <!-- Hardware and navigation are started once. The two motion controllers
       have separate velocity topics; only the manager forwards one to /cmd_vel. -->
  <include file="$(find maze_bridge)/launch/navigation_stack.launch">
    <arg name="mode" value="navigation"/>
    <arg name="map_file" value="$(arg map_file)"/>
    <arg name="initial_pose_x" value="$(arg initial_pose_x)"/>
    <arg name="initial_pose_y" value="$(arg initial_pose_y)"/>
    <arg name="initial_pose_a" value="$(arg initial_pose_a)"/>
    <arg name="show_rviz" value="$(arg show_rviz)"/>
    <arg name="port" value="$(arg base_port)"/>
    <arg name="camera_device" value="$(arg camera_device)"/>
    <arg name="camera_respawn" value="true"/>
    <arg name="camera_info_url" value="$(arg camera_info_url)"/>
    <arg name="max_v" value="$(arg max_speed)"/>
    <arg name="max_nav_v" value="$(arg max_speed)"/>
    <arg name="max_nav_w" value="$(arg max_turn)"/>
    <arg name="safety_stop_distance" value="$(arg safety_stop_distance)"/>
    <arg name="safety_slow_distance" value="0.60"/>
    <arg name="safety_collision_padding" value="0.03"/>
    <arg name="navigation_cmd_vel_topic" value="/handoff/cmd_vel_nav"/>
    <arg name="use_gimbal" value="true"/>
    <arg name="gimbal_port" value="$(arg gimbal_port)"/>
    <arg name="gimbal_required" value="true"/>
    <arg name="gimbal_auto_enable" value="true"/>
    <arg name="gimbal_pan_to_ros_sign" value="-1.0"/>
    <arg name="enable_blue_autonomy" value="false"/>
    <arg name="blue_h_min" value="95"/>
    <arg name="blue_h_max" value="130"/>
    <arg name="blue_s_min" value="140"/>
    <arg name="blue_min_aspect" value="0.30"/>
    <arg name="blue_reject_vertical_stripes" value="true"/>
    <arg name="blue_min_pixel_height" value="18"/>
    <arg name="black_line_enabled" value="false"/>
  </include>

  <node pkg="maze_planner" type="blue_goal_navigator" name="handoff_blue_navigator" output="screen">
    <remap from="/blue_autonomy/enable" to="/handoff/nav_enable"/>
    <remap from="/blue_autonomy/state" to="/handoff/nav_state"/>
    <remap from="/goal_reached" to="/handoff/nav_goal_reached"/>
    <param name="auto_start" value="false"/>
    <param name="start_delay" value="0.0"/>
    <param name="search_enabled" value="true"/>
    <param name="acquire_target_in_navigation" value="false"/>
    <param name="hold_at_course_end" value="true"/>
    <param name="prefer_forward_search" value="true"/>
    <param name="line_guidance_enabled" value="false"/>
    <rosparam if="$(eval arg('course_waypoints_file') != '')" command="load" file="$(arg course_waypoints_file)"/>
    <param name="require_localization" value="true"/>
    <param name="require_gimbal" value="true"/>
    <param name="require_camera_info" value="false"/>
    <param name="approach_clearance" value="0.37"/>
    <param name="search_goal_timeout" value="90.0"/>
    <param name="visual_tracking_parking_enabled" value="false"/>
    <param name="wall_parking_enabled" value="false"/>
  </node>

  <node pkg="maze_planner" type="direct_visual_controller" name="handoff_direct_visual" output="screen">
    <remap from="/blue_autonomy/enable" to="/handoff/visual_enable"/>
    <remap from="/blue_autonomy/state" to="/handoff/visual_state"/>
    <remap from="/goal_reached" to="/handoff/visual_goal_reached"/>
    <remap from="/cmd_vel" to="/handoff/cmd_vel_visual"/>
    <param name="auto_start" value="false"/>
    <param name="require_gimbal" value="true"/>
    <param name="max_speed" value="$(arg max_speed)"/>
    <param name="max_turn" value="$(arg max_turn)"/>
    <param name="stop_ratio" value="$(arg stop_ratio)"/>
    <param name="facing_tolerance_deg" value="$(arg facing_tolerance_deg)"/>
  </node>

  <node pkg="maze_planner" type="visual_handoff_manager" name="visual_handoff_manager" output="screen">
    <param name="auto_start" value="$(arg auto_start)"/>
    <param name="required_clear_scans" value="$(arg clear_scans)"/>
    <param name="max_target_range" value="$(arg max_target_range)"/>
    <param name="range_absolute_tolerance" value="$(arg range_absolute_tolerance)"/>
    <param name="range_relative_tolerance" value="$(arg range_relative_tolerance)"/>
    <param name="corridor_check_standoff" value="$(arg corridor_check_standoff)"/>
    <param name="max_sensor_skew" value="$(arg max_sensor_skew)"/>
  </node>
</launch>
