<launch>
  <arg name="show_rviz" default="true"/>
  <arg name="demo" default="true"/>
  <arg name="scenario" default="01_open"/>
  <arg name="max_nav_v" default="3.0"/>
  <arg name="max_nav_w" default="1.0"/>
  <arg name="scenario_file" default="$(find competition_sim)/relocated_scenarios/$(arg scenario)/scenario.json"/>
  <arg name="corner_clearance" default="true"/>
  <arg name="wall_endpoint_clearance" default="true"/>
  <arg name="wall_endpoint_radius" default="0.05"/>
  <arg name="report_file" default="$(find competition_sim)/../../outputs/relocated_obstacles_20261019/$(arg scenario)/result.json"/>
  <param name="use_sim_time" value="true"/>
  <param name="competition_simulation" value="true"/>
  <node pkg="stage_ros" type="stageros" name="competition_stage" required="true" output="screen"
        args="$(find competition_sim)/relocated_scenarios/$(arg scenario)/world.world">
    <remap from="base_scan" to="/scan_raw"/>
    <remap from="cmd_vel" to="/simulation/cmd_vel"/>
  </node>
  <node pkg="tf2_ros" type="static_transform_publisher" name="laser_alias"
        args="0 0 0 0 0 0 base_laser_link laser"/>
  <node pkg="stm32_bridge" type="scan_self_filter_node" name="scan_self_filter" output="screen">
    <param name="laser_x" value="0.315"/>
    <param name="padding" value="0.0"/>
  </node>
  <node pkg="map_server" type="map_server" name="map_server" required="true"
        args="$(find competition_sim)/maps/mapping_before_move.yaml"/>
  <node pkg="competition_sim" type="reconcile_prior_map.py" name="reconcile_prior_map" required="true" output="screen">
    <param name="map_file" value="$(find competition_sim)/maps/mapping_before_move.yaml"/>
    <param name="movable_mask" value="$(find competition_sim)/maps/movable_prior_mask.png"/>
  </node>
  <node pkg="amcl" type="amcl" name="amcl" output="screen">
    <param name="base_frame_id" value="base_footprint"/>
    <param name="odom_frame_id" value="odom"/>
    <param name="global_frame_id" value="map"/>
    <param name="use_map_topic" value="true"/>
    <param name="min_particles" value="300"/>
    <param name="max_particles" value="1000"/>
    <param name="update_min_d" value="0.02"/>
    <param name="update_min_a" value="0.02"/>
    <param name="resample_interval" value="1"/>
    <param name="transform_tolerance" value="0.3"/>
    <param name="initial_pose_x" value="6.562162162"/>
    <param name="initial_pose_y" value="6.920547945"/>
    <param name="initial_pose_a" value="-1.570796327"/>
    <param name="initial_cov_xx" value="0.0004"/>
    <param name="initial_cov_yy" value="0.0004"/>
    <param name="initial_cov_aa" value="0.0004"/>
    <param name="laser_min_range" value="0.1"/>
    <param name="laser_max_range" value="10"/>
    <param name="laser_max_beams" value="120"/>
    <param name="laser_model_type" value="likelihood_field_prob"/>
    <param name="do_beamskip" value="true"/>
    <param name="beam_skip_distance" value="0.2"/>
    <param name="beam_skip_threshold" value="0.3"/>
    <param name="beam_skip_error_threshold" value="0.9"/>
    <param name="laser_sigma_hit" value="0.05"/>
    <param name="force_update_after_initialpose" value="true"/>
  </node>
  <node pkg="maze_bridge" type="stationary_amcl_update.py" name="stationary_amcl_update">
    <remap from="/cmd_vel" to="/simulation/nav_cmd_vel"/>
  </node>
  <group if="$(arg corner_clearance)" ns="corner_clearance">
    <node pkg="maze_bridge" type="corner_clearance_map.py" name="map_provider" required="true" output="screen">
      <param name="map_file" value="$(find competition_sim)/maps/final_competition.yaml"/>
      <param name="extra_clearance" value="0.05"/>
      <param name="include_wall_endpoints" value="$(arg wall_endpoint_clearance)"/>
      <param name="wall_endpoint_radius" value="$(arg wall_endpoint_radius)"/>
      <param name="minimum_wall_length" value="0.25"/>
      <param name="scope" value="main_walls"/>
    </node>
  </group>
  <node pkg="move_base" type="move_base" name="move_base" output="screen" required="true" clear_params="true">
    <param name="base_global_planner" value="maze_smooth_planner/SmoothGlobalPlanner"/>
    <param name="base_local_planner" value="dwa_local_planner/DWAPlannerROS"/>
    <param name="controller_frequency" value="12"/>
    <param name="planner_frequency" value="5"/>
    <param name="controller_patience" value="45"/>
    <param name="planner_patience" value="30"/>
    <param name="oscillation_timeout" value="45"/>
    <param name="oscillation_distance" value="0.05"/>
    <param name="make_plan_clear_costmap" value="false"/>
    <param name="make_plan_add_unreachable_goal" value="false"/>
    <param name="recovery_behavior_enabled" value="false"/>
    <param name="clearing_rotation_allowed" value="false"/>
    <rosparam file="$(find maze_bridge)/launch/global_planner_params.yaml"/>
    <rosparam file="$(find maze_bridge)/launch/smooth_global_planner_params.yaml"/>
    <rosparam file="$(find maze_bridge)/launch/costmap_common_params.yaml" ns="global_costmap"/>
    <rosparam file="$(find maze_bridge)/launch/costmap_common_params.yaml" ns="local_costmap"/>
    <rosparam file="$(find maze_bridge)/launch/global_costmap_params.yaml"/>
    <rosparam file="$(find maze_bridge)/launch/local_costmap_params.yaml"/>
    <rosparam if="$(arg corner_clearance)" file="$(find maze_bridge)/launch/corner_clearance_costmap_params.yaml"/>
    <rosparam file="$(find maze_bridge)/launch/dwa_local_planner_params.yaml"/>
    <!-- Static prior changes only after laser-confirmed clearing of movable cells. -->
    <param name="global_costmap/static_layer/map_topic" value="/navigation_map"/>
    <param name="global_costmap/static_layer/first_map_only" value="false"/>
    <param name="global_costmap/static_layer/subscribe_to_updates" value="false"/>
    <param name="DWAPlannerROS/max_vel_x" value="$(arg max_nav_v)"/>
    <param name="DWAPlannerROS/max_vel_trans" value="$(arg max_nav_v)"/>
    <param name="DWAPlannerROS/max_vel_theta" value="$(arg max_nav_w)"/>
    <remap from="cmd_vel" to="/simulation/nav_cmd_vel"/>
  </node>
  <node pkg="competition_sim" type="simulation_safety_gate" name="simulation_safety_gate" required="true" output="screen">
    <param name="max_vel_x" value="$(arg max_nav_v)"/>
    <param name="max_vel_theta" value="$(arg max_nav_w)"/>
  </node>
  <rosparam file="$(find maze_bridge)/config/footprint_stl.yaml"/>
  <node pkg="competition_sim" type="scene_markers.py" name="competition_scene">
    <param name="scenario_file" value="$(arg scenario_file)"/>
  </node>
  <node if="$(arg demo)" pkg="competition_sim" type="demo_navigation.py" name="competition_demo" output="screen">
    <param name="report_file" value="$(arg report_file)"/>
    <param name="scenario_file" value="$(arg scenario_file)"/>
  </node>
  <node if="$(arg show_rviz)" pkg="rviz" type="rviz" name="competition_rviz" output="screen"
        args="-d $(find competition_sim)/rviz/competition.rviz"/>
</launch>
